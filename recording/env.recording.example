# env.recording.example
#
# Only the docker-jitsi-meet .env keys that THIS recording module needs or sets.
# Merge these into your existing jitsi/.env (the stock stack ships many more keys;
# these are the recording-relevant additions/overrides). Replace every placeholder.
#
# Reference base: docker-jitsi-meet stable-11031.

# --- Enable recording (Jibri) ---------------------------------------------------
# Turns on the Jibri path in the stock stack. Required for combined mp4 recording.
ENABLE_RECORDING=1

# --- Jibri service-account credentials (XMPP) -----------------------------------
# Jibri logs into prosody with these. Generate strong unique values (the stock
# `gen-passwords.sh` helper does this for you). NEVER commit real values.
JIBRI_XMPP_PASSWORD=<CHANGE_ME_random_secret>
JIBRI_RECORDER_PASSWORD=<CHANGE_ME_random_secret>

# --- Jigasi transcriber credentials (XMPP) --------------------------------------
# The multitrack export path reuses the transcriber login slot. Set even though we
# do not run Jigasi itself, so the account exists for the jicofo transcriber connect.
JIGASI_TRANSCRIBER_PASSWORD=<CHANGE_ME_random_secret>

# --- Jibri recording output + quality -------------------------------------------
# Path INSIDE the jibri container where Jibri writes the raw session before finalize.
JIBRI_RECORDING_DIR=/config/recordings
# 720p keeps one concurrent recording within ~2 vCPU / 3 GB (see README requirements).
JIBRI_RECORDING_RESOLUTION=1280x720
JIBRI_RECORDING_FRAMERATE=30
# x264 CRF (lower = better quality/larger file) and encode preset.
JIBRI_RECORDING_CONSTANT_RATE_FACTOR=23
JIBRI_RECORDING_VIDEO_ENCODE_PRESET_RECORDING=veryfast

# --- Jibri finalize hook --------------------------------------------------------
# Path INSIDE the jibri container to this module's finalize.sh. Install jibri/finalize.sh
# to your jibri config dir (e.g. ~/.jitsi-meet-cfg/jibri/finalize.sh) and point here.
JIBRI_FINALIZE_RECORDING_SCRIPT_PATH=/config/finalize.sh

# --- Recording metadata (required for the multitrack/transcriber chain) ---------
# Makes prosody accept and propagate the recording metadata that mod_jibri_autostart
# sets. Without it, jicofo never sees isTranscribingEnabled and the JMR export no-ops.
PROSODY_ENABLE_RECORDING_METADATA=1

# --- Custom prosody MUC modules (this module) -----------------------------------
# Load both plugins from prosody-plugins-custom/ under the conference MUC component.
# jibri_autostart  -> auto-start recording + enable JMR multitrack export
# participant_log  -> live participants.json keyed by meetingId (for named WAVs)
XMPP_MUC_MODULES=jibri_autostart,participant_log

# --- Timezone (used by JMR container / finalize timestamps) ---------------------
TZ=UTC
